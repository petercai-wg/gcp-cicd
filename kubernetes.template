apiVersion: apps/v1
kind: Deployment
metadata:
  name: productcatalogue
  labels:
    app: productcatalogue
spec:
  selector:
    matchLabels:
      app: productcatalogue
  replicas: 2
  template:
    metadata:
      labels:
        app: productcatalogue
    spec:
      containers:
      - name: productcatalogue
        image: us-central1-docker.pkg.dev/{GOOGLE_CLOUD_PROJECT}/my-us-repo/productcatalogue:{COMMIT_SHA}
        ports:
        - containerPort: 8080
        env:
        - name: PRODUCT_SVC_PORT
          value: "8080"

---
apiVersion: v1
kind: Service
metadata:
  name: productcatalogue
  labels:
    app: productcatalogue
spec:
  type: NodePort
  selector:
    app: productcatalogue
  ports:
  - protocol: TCP
    port: 8020
    targetPort: 8080
    nodePort: 32080    # Specific port on all nodes (optional)


---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stockmanager
  labels:
    app: stockmanager
spec:
  selector:
    matchLabels:
      app: stockmanager
  replicas: 3
  template:
    metadata:
      labels:
        app: stockmanager
    spec:
      containers:
      - name: stockmanager
        image: us-central1-docker.pkg.dev/{GOOGLE_CLOUD_PROJECT}/my-us-repo/stockmanager:{COMMIT_SHA}
        ports:
        - containerPort: 8080
        env:
        - name: STOCK_MANAGER_PORT
          value: "8080"

---
apiVersion: v1
kind: Service
metadata:
  name: stockmanager
  labels:
    app: stockmanager
spec:
  type: NodePort
  selector:
    app: stockmanager
  ports:
  - protocol: TCP
    port: 8030
    targetPort: 8080    
    nodePort: 30308    # Specific port on all nodes (optional)

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webfront
  labels:
    app: webfront
spec:
  selector:
    matchLabels:
      app: webfront
  replicas: 2
  template:
    metadata:
      labels:
        app: webfront
    spec:
      containers:
      - name: webfront
        image: us-central1-docker.pkg.dev/{GOOGLE_CLOUD_PROJECT}/my-us-repo/webfront:{COMMIT_SHA}
        ports:
        - containerPort: 8080
        env:
        - name: WEBFRONT_PORT
          value: "8080"
        - name: productCatalogueUri
          value: "http://productcatalogue:8080"
        - name: stockManagerUri
          value: "http://stockmanager:8080"


