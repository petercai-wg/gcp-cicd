apiVersion: apps/v1
kind: Deployment
metadata:
  name: productcatalogue
  labels:
    app: productcatalogue
spec:
  selector:
    matchLabels:
      app: productcatalogue
  replicas: 1
  template:
    metadata:
      labels:
        app: productcatalogue
    spec:
      containers:
      - name: productcatalogue
        image: northamerica-northeast2-docker.pkg.dev/{GOOGLE_CLOUD_PROJECT}/my-repository/productcatalogue:{COMMIT_SHA}
        ports:
        - containerPort: 8080
        env:
        - name: PRODUCT_SVC_PORT
          value: "8080"
        - name: OTEL_SERVICE_NAME
          value: stockmanager
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: http://localhost:4317
        - name: OTEL_EXPORTER_OTLP_PROTOCOL
          value: grpc

      # Telemetry Sidecar collector
      - name: otel-sidecar
        image: otel/opentelemetry-collector-contrib:latest
        args:
          - --config=/etc/otel/config.yaml        
        volumeMounts:
        - name: sidecar-config
          mountPath: /etc/otel

      volumes:
      - name: sidecar-config
        configMap:
          name: otel-sidecar-config

---
apiVersion: v1
kind: Service
metadata:
  name: productcatalogue
  labels:
    app: productcatalogue
spec:
  type: NodePort
  selector:
    app: productcatalogue
  ports:
  - protocol: TCP
    port: 8020
    targetPort: 8080
    nodePort: 32080    # Specific port on all nodes (optional)


---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stockmanager
  labels:
    app: stockmanager
spec:
  selector:
    matchLabels:
      app: stockmanager
  replicas: 1
  template:
    metadata:
      labels:
        app: stockmanager
    spec:
      containers:
      - name: stockmanager
        image: northamerica-northeast2-docker.pkg.dev/{GOOGLE_CLOUD_PROJECT}/my-repository/stockmanager:{COMMIT_SHA}
        ports:
        - containerPort: 8080
        env:
        - name: STOCK_MANAGER_PORT
          value: "8080"
        - name: OTEL_SERVICE_NAME
          value: stockmanager
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: http://otel-collector:4317
        - name: OTEL_EXPORTER_OTLP_PROTOCOL
          value: grpc

---
apiVersion: v1
kind: Service
metadata:
  name: stockmanager
  labels:
    app: stockmanager
spec:
  type: NodePort
  selector:
    app: stockmanager
  ports:
  - protocol: TCP
    port: 8030
    targetPort: 8080    
    nodePort: 30308    # Specific port on all nodes (optional)

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webfront
  labels:
    app: webfront
spec:
  selector:
    matchLabels:
      app: webfront
  replicas: 2
  template:
    metadata:
      labels:
        app: webfront
    spec:
      containers:
      - name: webfront
        image: northamerica-northeast2-docker.pkg.dev/{GOOGLE_CLOUD_PROJECT}/my-repository/webfront:{COMMIT_SHA}
        ports:
        - containerPort: 8080
        env:
        - name: WEBFRONT_PORT
          value: "8080"
        - name: productCatalogueUri
          value: "http://productcatalogue:8020"
        - name: stockManagerUri
          value: "http://stockmanager:8030"

        - name: OTEL_SERVICE_NAME
          value: webfront
        - name: OTEL_EXPORTER_OTLP_ENDPOINT
          value: http://otel-collector:4317
        - name: OTEL_EXPORTER_OTLP_PROTOCOL
          value: grpc
        - name: OTEL_TRACES_SAMPLER
          value: always_on
        - name: OTEL_LOG_LEVEL
          value: debug  

---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: otel-collector
spec:
  replicas: 1
  selector:
    matchLabels:
      app: otel-collector
  template:
    metadata:
      labels:
        app: otel-collector
    spec:
      containers:
      - name: collector
        image: otel/opentelemetry-collector-contrib:latest
        args:
          - --config=/etc/otel/config.yaml
        volumeMounts:
        - name: config
          mountPath: /etc/otel
      volumes:
      - name: config
        configMap:
          name: otel-collector-config

---

apiVersion: v1
kind: Service
metadata:
  name: otel-collector
spec:
  selector:
    app: otel-collector
  ports:
  - port: 4317
    targetPort: 4317
    name: grpc


---
